# Copy this file to .env for local development. Do not commit your real token.
HF_TOKEN=hf_replace_with_your_token

# GitHub Actions can inject a repository secret into this alternative name.
# GITHUB_HF_TOKEN=hf_replace_with_your_token

# Optional: override the default Google Gemma model.
# HF_MODEL=google/gemma-4-31B-it
